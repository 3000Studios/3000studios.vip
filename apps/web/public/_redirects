# Static assets first — never rewrite these to index.html
/assets/*  /assets/:splat  200
/media/*   /media/:splat   200
/favicon.svg  /favicon.svg  200
/favicon.ico  /favicon.ico  200
/listen.html  /listen.html  200
/listen  /listen.html  200

# Pages Functions under /api must not fall through to the SPA
/api/*  /api/:splat  200

# SPA fallback for client routes only
/*  /index.html  200
