# Static assets first — never rewrite these to index.html
/assets/*  /assets/:splat  200
/media/*   /media/:splat   200
/favicon.svg  /favicon.svg  200
/favicon.ico  /favicon.ico  200
/listen.html  /listen.html  200
/listen  /listen.html  200
/links  /links/index.html  200
/links/  /links/index.html  200
/tiktok  /tiktok/index.html  200
/tiktok/  /tiktok/index.html  200
/tiktok-games  /tiktok-games/index.html  200
/tiktok-games/  /tiktok-games/index.html  200
/tiktok-games/*  /tiktok-games/:splat  200

# Do not 200-rewrite /privacy or /terms to *.html. Pages pretty-URLs already
# serve privacy.html at /privacy; rewriting to .html 308-loops (AdSense reject).

# Privacy canonicalization — /privacy is the one canonical policy URL
/privacy-policy  /privacy  301
/privacy-policy/  /privacy  301

# Blueprint aliases — only expose working surfaces (no empty SPA shells)
/videos  /video  302
/videos/  /video  302
/videos/*  /video  302
/arcade  /tiktok-games/  302
/arcade/  /tiktok-games/  302
/arcade/*  /tiktok-games/:splat  302
/releases  /music  302
/releases/  /music  302
/releases/*  /music  302

# Canonical privacy page is the static /privacy; dedupe the SPA duplicate.
/privacy-policy  /privacy  301

# Pages Functions under /api must not fall through to the SPA.
# Prefer Functions (or Worker route) over this rewrite; keep as pass-through guard.
/api/*  /api/:splat  200

# SPA-only routes (React Router paths with no static file — see src/main.tsx).
# Each serves the app shell at its own URL so the router can render it.
# There is deliberately NO /* catch-all: Pages' validator ignores splat ->
# /index.html rules as infinite loops, and with dist/404.html present
# (scripts/generate-404.mjs) unmatched paths are served 404.html with a
# genuine 404 status. Rewrite target is / (the directory index), never
# /index.html — the validator discards that target. Routes that DO have a
# static file (/, /privacy, /terms, /thunderdome-privacy, /listen, /links,
# /tiktok, /tiktok-games) need no rule: the file serves at its own URL.
/about / 200
/admin / 200
/aeropocalypse / 200
/aeropocalypse/privacy / 200
/agent / 200
/apps / 200
/beats / 200
